---
import { href, hasText, list, isExternal } from '../lib/content.js';
const { settings, footer = {} } = Astro.props;
const site = settings.footer ?? {};
const simple = footer.style === 'simple';
const links = list(simple ? footer.links : site.links).filter((l) => l && hasText(l.label));
const copyright = simple ? footer.copyright : site.copyright;
---
<footer id="contact" class="site-footer g-obsidian">
  <div class="wrap row">
    {!simple && hasText(site.wordmark_line) && <span class="wm">{site.wordmark_line}</span>}
    {simple && hasText(copyright) && <span>{copyright}</span>}
    {links.length > 0 && (
      <ul class="links">
        {links.map((l) => {
          const u = href(l.link);
          return <li>{u ? <a href={u} rel={isExternal(l.link) ? 'noopener' : undefined}>{l.label}</a> : <span class="todo" title={l.link}>{l.label}</span>}</li>;
        })}
      </ul>
    )}
    {!simple && hasText(copyright) && <span>{copyright}</span>}
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--umber); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px 24px; padding-block: 40px; font-family: var(--font-label); font-size: 12px; letter-spacing: 0.24em; color: var(--stone); }
  .wm { color: var(--bone); letter-spacing: 0.32em; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .links a, .links span { display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; color: var(--stone); }
  .links a:hover { color: var(--bone); }
  .todo { opacity: 0.6; }
  @media (max-width: 767px) { .row { flex-direction: column; align-items: flex-start; } }
</style>
