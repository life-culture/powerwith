---
import { hasText } from '../../lib/content.js';
const { s, id, g } = Astro.props;
---
{hasText(s.quote) && (
<section id={id} class={g} aria-label={s.attribution || undefined}>
  <figure class="wrap row">
    <blockquote class="display q">{s.quote}</blockquote>
    {hasText(s.attribution) && <figcaption class="kicker">{s.attribution}</figcaption>}
  </figure>
</section>
)}
<style>
  .row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px; padding-block: 36px; }
  .q { flex: 999 1 480px; font-size: clamp(22px, 2.4vw, 26px); line-height: 1.3; }
</style>
