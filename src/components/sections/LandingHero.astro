---
import { inline, hasText, list, ground } from '../../lib/content.js';
import SectionHead from '../SectionHead.astro';
import OptinForm from '../OptinForm.astro';
const { s, id, g, first } = Astro.props;
const items = list(s.list);
const card = s.form_card ?? {};
---
<section id={id} class={`hero ${g}`}>
  <div class="wrap split inner">
    <div class="grow">
      <SectionHead kicker={s.kicker} headline={s.headline} size={s.headline_size} h1={first} scale="lg" />
      {hasText(s.subhead) && <p class="display italic muted sub">{s.subhead}</p>}
      {hasText(s.body) && <p class="body measure mt-m" set:html={inline(s.body)} />}
      {items.length > 0 && (
        <>
          {hasText(s.list_label) && <h2 class="kicker mt-l">{s.list_label}</h2>}
          <ul class="rule-list mt-s items">{items.map((t) => <li set:html={inline(t)} />)}</ul>
        </>
      )}
      {hasText(s.audience) && <p class="body muted mt-m" set:html={inline(s.audience)} />}
    </div>
    <div class={`side card g-${ground(card.ground, 'clay')}`}>
      {hasText(card.heading) && <p class="display d-quote heading">{card.heading}</p>}
      <OptinForm form={card.form} layout="col" />
      {hasText(card.helper) && <p class="body-sm mt-s" set:html={inline(card.helper)} />}
    </div>
  </div>
</section>
<style>
  .hero { padding-block: 40px 56px; }
  .inner { align-items: flex-start; }
  .sub { margin-top: 24px; font-size: clamp(23px, 2.4vw, 30px); line-height: 1.25; }
  .items { font-size: 20px; line-height: 1.45; }
  .items li { padding-block: 12px; }
  .card { padding: 28px 22px; flex-basis: 360px; }
  .heading { margin-bottom: 18px; }
  @media (min-width: 768px) { .hero { padding-block: 80px 96px; } .card { padding: 36px; position: sticky; top: 24px; } }
</style>
