---
// Brand-kit icons, coloured with currentColor.
const { name, size = 48, class: cls = '' } = Astro.props;
const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = files[`../icons/${name}.svg`];
---
{svg && <span class={`icon ${cls}`} style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={svg} />}
<style>
  .icon { display: inline-block; }
  .icon :global(svg) { width: 100%; height: 100%; }
</style>
