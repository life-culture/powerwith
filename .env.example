# Used by the signup function in api/subscribe.js (set these in Vercel, never commit real values)
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=
# Comma-separated sites allowed to send signups
ALLOWED_ORIGINS=https://life-culture.github.io,http://localhost:4321
# Optional, for the editor's "Sign in with GitHub" button (api/auth.js, api/callback.js)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
