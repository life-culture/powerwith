{
  "$description": "Power With website design tokens. Ochre is removed from the brand; Clay replaces it. Values match 03_DESIGN_SYSTEM.md.",
  "color": {
    "obsidian": "#0F0E0C",
    "bone": "#EDE6D8",
    "stone": "#C2B8A6",
    "umber": "#3A3531",
    "oxblood": "#4A1C18",
    "clay": "#8E4A30",
    "olive": "#3C402F"
  },
  "grounds": {
    "obsidian": { "background": "obsidian", "text": "bone", "label": "stone", "rule": "clay", "hairline": "umber", "buttonPrimaryBg": "clay", "buttonPrimaryText": "bone", "inputBg": "transparent", "inputText": "bone", "inputBorder": "stone" },
    "bone":     { "background": "bone", "text": "obsidian", "label": "umber", "rule": "clay", "hairline": "umber", "buttonPrimaryBg": "obsidian", "buttonPrimaryText": "bone", "inputBg": "transparent", "inputText": "obsidian", "inputBorder": "umber" },
    "umber":    { "background": "umber", "text": "bone", "label": "stone", "rule": "stone", "hairline": "stone", "buttonPrimaryBg": "bone", "buttonPrimaryText": "obsidian", "inputBg": "transparent", "inputText": "bone", "inputBorder": "stone" },
    "oxblood":  { "background": "oxblood", "text": "bone", "label": "stone", "rule": "stone", "hairline": "stone", "buttonPrimaryBg": "bone", "buttonPrimaryText": "obsidian", "inputBg": "transparent", "inputText": "bone", "inputBorder": "stone" },
    "clay":     { "background": "clay", "text": "bone", "label": "bone", "rule": "bone", "hairline": "bone", "buttonPrimaryBg": "obsidian", "buttonPrimaryText": "bone", "inputBg": "bone", "inputText": "obsidian", "inputBorder": "obsidian" },
    "olive":    { "background": "olive", "text": "bone", "label": "stone", "rule": "stone", "hairline": "stone", "buttonPrimaryBg": "bone", "buttonPrimaryText": "obsidian", "inputBg": "transparent", "inputText": "bone", "inputBorder": "stone" }
  },
  "contrastRules": {
    "clayTextOnObsidian": "forbidden (about 2.9:1). Use for buttons with bone text, rules and marks only."
  },
  "font": {
    "display": "'Cormorant Garamond', Georgia, serif",
    "body": "'EB Garamond', Georgia, serif",
    "label": "Montserrat, Helvetica, Arial, sans-serif",
    "weights": { "display": 500, "body": 400, "label": 400, "labelLarge": 300 }
  },
  "type": {
    "display-xl": { "desktop": "96px", "mobile": "58px", "lineHeight": 1.0, "font": "display" },
    "display-lg": { "desktop": "76px", "mobile": "44px", "lineHeight": 1.02, "font": "display" },
    "display-md": { "desktop": "60px", "desktopLarge": "64px", "mobile": "40px", "lineHeight": 1.08, "font": "display" },
    "display-sm": { "desktop": "34px", "mobile": "27px", "lineHeight": 1.2, "font": "display" },
    "quote":      { "desktop": "30px", "mobile": "23px", "lineHeight": 1.25, "font": "display" },
    "body-lg":    { "desktop": "21px", "mobile": "19px", "lineHeight": 1.5, "font": "body" },
    "body-sm":    { "desktop": "17px", "mobile": "16px", "lineHeight": 1.45, "font": "body" },
    "label":      { "desktop": "12px", "mobile": "11px", "letterSpacing": "0.30em", "transform": "uppercase", "font": "label" },
    "button":     { "desktop": "12px", "mobile": "12px", "letterSpacing": "0.22em", "transform": "uppercase", "font": "label" },
    "wordmark":   { "desktop": "14px", "mobile": "12px", "letterSpacing": "0.32em", "transform": "uppercase", "font": "label" }
  },
  "space": {
    "contentMax": "1200px",
    "narrowMax": "1000px",
    "ctaMax": "760px",
    "gutterDesktop": "32px",
    "gutterMobile": "20px",
    "sectionPadDesktop": "112px",
    "sectionPadMobile": "56px",
    "ruleWidthDesktop": "64px",
    "ruleWidthMobile": "48px",
    "ruleHeight": "2px",
    "buttonPad": "18px 28px",
    "inputPad": "16px 18px",
    "minTouch": "44px"
  },
  "radius": "0",
  "shadow": { "bookCover": "0 30px 60px rgba(0,0,0,0.55)" },
  "motion": { "fade": "250ms ease-out", "reducedMotion": "none" }
}
